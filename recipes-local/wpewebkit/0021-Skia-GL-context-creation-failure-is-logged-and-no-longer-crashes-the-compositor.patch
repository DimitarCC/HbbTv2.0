From: xcentaurix
Subject: [PATCH] Skia: log why GrDirectContexts::MakeGL fails, and do not crash the ThreadedCompositor when it does

Symptom (VU+ Ultimo 4K, Nexus/V3D GLES2 driver, after patch 0019): the WebProcess dies with a SIGSEGV on the "ThreadedCompositor" thread right after the Nexus
join/register lines, reported as "WEB PROCESS TERMINATED (reason 0)". gdb: a null pointer read (ldr r3,[r1,#8], r1 = 0) copying a ref-counted pointer, in
Skia's GrContext_Base::threadSafeProxy(), called from the ThreadedCompositor constructor's work queue lambda:

  m_threadSafeGrContext = PlatformDisplay::sharedDisplay().skiaGrContext()->threadSafeProxy();

skiaGrContext() is null when SkiaGLContext's constructor could not make a GrDirectContext (GrDirectContexts::MakeGL returned null: Skia rejected the GL
interface or the driver). Nothing checked for that.

This patch (1) prints the reason-relevant driver state when MakeGL fails (GL_VENDOR, GL_RENDERER, GL_VERSION, GL_SHADING_LANGUAGE_VERSION, GL_EXTENSIONS,
glGetError) to stderr, which is the log of wpe_fb, and (2) invalidates the compositor, as it already does when it cannot make its GL context, instead of
dereferencing null. It does not make the page render: it turns the crash into a log line that says what to fix.
---
diff -u -r a/Source/WebCore/platform/graphics/skia/PlatformDisplaySkia.cpp b/Source/WebCore/platform/graphics/skia/PlatformDisplaySkia.cpp
--- a/Source/WebCore/platform/graphics/skia/PlatformDisplaySkia.cpp	2026-10-30 13:51:24.786980900 +0200
+++ b/Source/WebCore/platform/graphics/skia/PlatformDisplaySkia.cpp	2026-10-30 13:51:50.694044600 +0200
@@ -41,14 +41,17 @@
 
 #if USE(LIBEPOXY)
 #include <epoxy/egl.h>
+#include <epoxy/gl.h>
 #include <skia/gpu/ganesh/gl/epoxy/GrGLMakeEpoxyEGLInterface.h>
 #else
 #include <EGL/egl.h>
 #include <EGL/eglext.h>
+#include <GLES2/gl2.h>
 #include <skia/gpu/ganesh/gl/egl/GrGLMakeEGLInterface.h>
 #endif
 WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_END
 
+#include <cstdio>
 #include <wtf/MemoryPressureHandler.h>
 #include <wtf/NeverDestroyed.h>
 #include <wtf/RAMSize.h>
@@ -93,6 +96,19 @@
     return grGLInterface.get();
 }
 
+// Skia refuses to make a GPU context on some drivers (a missing function or extension, an unsupported version, no memory): say why, with what the driver
+// reports, instead of leaving it to whoever finds the context null later.
+static void logSkiaGLContextFailure(const sk_sp<const GrGLInterface>& glInterface)
+{
+    auto text = [](GLenum name) {
+        auto* value = reinterpret_cast<const char*>(glGetString(name));
+        return value ? value : "(null)";
+    };
+    GLenum error = glGetError();
+    fprintf(stderr, "Skia: GrDirectContexts::MakeGL failed (GL interface %s, glGetError 0x%x)\n  GL_VENDOR     %s\n  GL_RENDERER   %s\n  GL_VERSION    %s\n  GL_SHADING    %s\n  GL_EXTENSIONS %s\n",
+        glInterface ? "created" : "NOT created", static_cast<unsigned>(error), text(GL_VENDOR), text(GL_RENDERER), text(GL_VERSION), text(GL_SHADING_LANGUAGE_VERSION), text(GL_EXTENSIONS));
+}
+
 static thread_local RefPtr<SkiaGLContext> s_skiaGLContext;
 
 #if USE(LIBDRM)
@@ -347,7 +363,8 @@
             m_skiaGrContext = WTF::move(grContext);
             m_sampleCount = initializeMSAASampleCount(m_skiaGrContext.get());
             m_maxResourceCacheBytes = initializeMaxResourceCacheBytes(m_skiaGrContext.get());
-        }
+        } else
+            logSkiaGLContextFailure(skiaGLInterface());
     }
 
     std::unique_ptr<GLContext> m_skiaGLContext WTF_GUARDED_BY_LOCK(m_lock);
diff -u -r a/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/ThreadedCompositor.cpp b/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/ThreadedCompositor.cpp
--- a/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/ThreadedCompositor.cpp	2026-10-30 13:51:24.824794600 +0200
+++ b/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/ThreadedCompositor.cpp	2026-10-30 13:51:50.695021200 +0200
@@ -125,7 +125,14 @@
 
         if (m_useSkia) {
             PlatformDisplay::sharedDisplay().setSkiaGLContextForCurrentThread(WTF::move(context));
-            m_threadSafeGrContext = PlatformDisplay::sharedDisplay().skiaGrContext()->threadSafeProxy();
+            // Skia may refuse to make a GPU context on this driver (see logSkiaGLContextFailure): there is nothing to composite with then.
+            auto* grContext = PlatformDisplay::sharedDisplay().skiaGrContext();
+            if (!grContext) {
+                Locker locker { m_state.lock };
+                m_state.state = State::Invalidated;
+                return;
+            }
+            m_threadSafeGrContext = grContext->threadSafeProxy();
         } else {
             m_context = WTF::move(context);
             m_textureMapper = TextureMapper::create();
