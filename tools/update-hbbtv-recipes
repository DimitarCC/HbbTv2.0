#!/usr/bin/env bash
set -e

# oe-alliance-core branch
BRANCH="6.0"

VERSION_URL="https://raw.githubusercontent.com/oe-alliance/distro-versions/$BRANCH/openvix.conf"
VERSION=$(curl -fsSL "$VERSION_URL" | tr -d '\r' | sed -n 's/^DISTRO_VERSION *= *"\(.*\)".*/\1/p')

if [ -z "$VERSION" ]; then
    echo "Could not read DISTRO_VERSION from $VERSION_URL"
    exit 1
fi

USERNAME="OpenViX"
REPO="HbbTv2.0"

REPO_URL="https://github.com/$USERNAME/$REPO.git"
CLONE_DIR="$HOME/$REPO"
SOURCE_DIR="$CLONE_DIR/recipes-local"
TARGET_DIR="$HOME/$VERSION/meta-local/recipes-local"

# Clone if the repo doesn't exist; otherwise pull latest changes
if [ ! -d "$CLONE_DIR/.git" ]; then
    git clone "$REPO_URL" "$CLONE_DIR"
else
    git -C "$CLONE_DIR" pull
fi

# Ensure the target directory exists
mkdir -p "$TARGET_DIR"

# Copy files, overwriting existing files
cp -a "$SOURCE_DIR/." "$TARGET_DIR/"

echo "Recipes copied successfully."
